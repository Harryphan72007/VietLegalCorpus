{
  "$defs": {
    "RetrievalMethod": {
      "description": "Supported ways a source artifact can enter immutable storage.",
      "enum": [
        "local_file",
        "official_http"
      ],
      "title": "RetrievalMethod",
      "type": "string"
    }
  },
  "$id": "urn:pio1:vietlegalcorpus:1.0.0:source_artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact bytes acquired from an explicit local or official source.",
  "properties": {
    "artifact_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Artifact Id",
      "type": "string"
    },
    "byte_length": {
      "minimum": 0,
      "title": "Byte Length",
      "type": "integer"
    },
    "etag": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etag"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "last_modified": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Modified"
    },
    "media_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]+$",
      "title": "Media Type",
      "type": "string"
    },
    "retrieval_method": {
      "$ref": "#/$defs/RetrievalMethod"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_locator": {
      "minLength": 1,
      "title": "Source Locator",
      "type": "string"
    },
    "storage_path": {
      "minLength": 1,
      "title": "Storage Path",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "source_locator",
    "retrieval_method",
    "retrieved_at",
    "media_type",
    "byte_length",
    "sha256",
    "storage_path"
  ],
  "title": "SourceArtifact",
  "type": "object"
}
